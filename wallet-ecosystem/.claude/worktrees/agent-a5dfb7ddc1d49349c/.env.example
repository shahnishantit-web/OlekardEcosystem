# Wallet Ecosystem — Root environment variables
# Copy to .env and populate. NEVER commit .env with real values.

# Shared across all services
APP_ENV=local
APP_DEBUG=false

# PostgreSQL (shared host in monolith phase; change per-module for extraction)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wallet_ecosystem
DB_USERNAME=wallet_app
DB_PASSWORD=password1234

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Admin (Next.js)
NEXT_PUBLIC_API_URL=http://api:8080
