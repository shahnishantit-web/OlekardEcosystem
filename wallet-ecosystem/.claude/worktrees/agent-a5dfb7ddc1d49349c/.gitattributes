# Normalize line endings to LF on checkout for cross-platform consistency
* text=auto eol=lf

# Force binary treatment for image and binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.pdf binary
*.zip binary

# PHP
*.php text eol=lf diff=php

# JavaScript / TypeScript
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# Dart
*.dart text eol=lf diff=dart

# YAML / TOML
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Markdown
*.md text eol=lf

# Dockerfile
Dockerfile text eol=lf
*.dockerfile text eol=lf
