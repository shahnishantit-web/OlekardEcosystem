APP_NAME="Wallet Ecosystem API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging — structured JSON to stderr (FR-085)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database — default connection (monolith: all schemas same host)
DB_CONNECTION=platform
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wallet_ecosystem
DB_USERNAME=wallet_app
DB_PASSWORD=

# Redis — queue, cache, idempotency cache
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache & Queue
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Sessions (API — stateless, no session storage needed)
SESSION_DRIVER=array
SESSION_LIFETIME=120

# Laravel Horizon
HORIZON_PREFIX=wallet:
HORIZON_MEMORY_LIMIT=128

# Security (FR-063–FR-072)
IDENTITY_JWKS_URI=          # TBD — set to JWKS endpoint when Identity module deployed
JWT_ALGORITHM=RS256

# Idempotency
IDEMPOTENCY_PROCESSING_TIMEOUT_SECONDS=   # TBD — configurable; leave blank until value approved

# Design system CDN
DESIGN_SYSTEM_CDN_URL=      # TBD — set for production

# OpenTelemetry (TBD backend)
OTEL_EXPORTER_OTLP_ENDPOINT=   # TBD — no-op when unset

# E20 — Reconciliation & Settlement
RECONCILIATION_WEBHOOK_SECRET=   # Required: HMAC-SHA256 secret for provider webhook auth

# E23 — Audit & Compliance
AUDIT_HMAC_KEY=   # Required: HMAC-SHA256 secret for audit event integrity hashes — generate with: openssl rand -hex 32

# E24 — Reporting & Analytics
REPORTS_STORAGE_DRIVER=local   # Set to 's3' for production
REPORTS_S3_BUCKET=             # S3 bucket for report export files
REPORTS_S3_REGION=             # AWS region for reports bucket

# E26 — Security Hardening
CSP_POLICY="default-src 'self'; frame-ancestors 'none'"   # Content-Security-Policy header; tighten per deployment (add CDN origins as needed)
PERMISSIONS_POLICY="camera=(), microphone=(), payment=()"  # Permissions-Policy header; restricts browser APIs
HSTS_MAX_AGE=31536000                                       # HSTS max-age in seconds (default: 1 year)
